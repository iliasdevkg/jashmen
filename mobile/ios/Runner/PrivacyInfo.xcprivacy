<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple has required this file of every app since May 2024; an upload
	     without one is rejected at processing. It has to agree with the App
	     Privacy answers in App Store Connect — the two are compared, and a
	     mismatch is what turns a routine review into a rejection.

	     JashMen shows no ads, embeds no analytics SDK and has no attribution
	     of any kind, so the honest answer to almost everything here is "no".
	     What it does collect is the handful of fields an account needs. -->

	<key>NSPrivacyTracking</key>
	<false/>

	<!-- Empty because nothing here talks to a tracking domain. If an
	     analytics or attribution SDK is ever added, its domains belong in
	     this array and NSPrivacyTracking above becomes true. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The sign-in address. Linked to the account by definition; it is
		     how someone gets back into it. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The display name, shown on the leaderboard the learner chose to
		     compete on. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The profile picture, only if the learner picks one. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The account id the server issues. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Which lessons were finished and when. This is the product: the
		     streak, the league and the shop are all built on it, and it is
		     kept against the account rather than pooled anonymously. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required-reason APIs. Empty for this target on purpose: the app's own
	     Swift is the Flutter template's AppDelegate and SceneDelegate, which
	     touch none of them. The plugins that do — shared_preferences
	     (UserDefaults), path_provider and cached_network_image (file
	     timestamps), flutter_secure_storage (Keychain) — each ship their own
	     manifest, and Xcode merges all of them into the bundle. Declaring
	     their reasons here as well would be claiming APIs this target does
	     not call. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
