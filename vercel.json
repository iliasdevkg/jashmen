{
  "crons": [
    { "path": "/admin/api/cron/streak-reminders", "schedule": "0 18 * * *" }
  ],
  "rewrites": [
    {
      "source": "/admin/api/:path*",
      "destination": "https://jashmen-api.vercel.app/admin/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin/).*)",
      "destination": "/index.html"
    }
  ]
}
