# Copy to admin-api/.env (or set as real env vars in your deploy target).
# `npm run server` / `npm run dev:all` load this file automatically via
# Node's --env-file-if-exists — nothing else to wire up.
# The root .gitignore already excludes .env files.

# Secret used to sign auth tokens. Required for real deployments — the
# server falls back to an insecure default and warns loudly if unset.
JWT_SECRET=change-me-to-a-long-random-string

# Port the API listens on. vite.config.js proxies /admin/api to this port
# in dev; keep them in sync if you change it.
PORT=3030

# Shared password for the admin panel (/admin/api/admin/login). Required to
# use the admin panel at all — without it every login attempt is rejected.
# This is deliberately a single shared operator password, not a per-admin
# account system — see admin-api/adminAuth.js for why.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: separate signing secret for admin tokens. Falls back to
# JWT_SECRET, then an insecure dev default, if unset.
ADMIN_JWT_SECRET=

# Optional: Vercel Blob token for uploaded media (lesson photos/video,
# partner logos, prize photos). Unset → falls back to local disk
# (admin-api/data/uploads/), which is fine for local dev but does NOT
# survive a serverless deploy. To go live: Vercel dashboard → Storage →
# create a Blob store → copy its token here. No code change needed either way.
BLOB_READ_WRITE_TOKEN=

# Optional: VAPID keys for real Web Push (streak-reminder notifications).
# Generate once with `npx web-push generate-vapid-keys` and paste both
# below — same pair forever, don't regenerate per deploy (that would
# invalidate every existing subscription). Unset → push notifications are
# silently disabled; the app still works, subscribe just no-ops.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@jashmen.app

# ── Sign in with Google ──────────────────────────────────────────────────
# Only the client IDs are needed: verifying an id_token is a signature check
# against Google's public keys (google-auth-library fetches and caches them),
# so there is NO client secret on the server. The web ID doubles as the
# "server client ID" the Android app requests its token for.
#
# Unset → POST /u/auth/google returns 503 and the Google button is hidden;
# email/password sign-in keeps working. See docs/GOOGLE_SIGNIN.md.
GOOGLE_CLIENT_ID=
# Only if the mobile apps ship — iOS needs its own OAuth client, Android
# registers by package name + SHA-1 and usually needs no extra audience.
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ── Sign in with Apple ──────────────────────────────────────────────────
# Required by App Store Guideline 4.8 anywhere the Google button ships:
# an iOS app offering any third-party sign-in must offer Apple's too.
#
# APPLE_BUNDLE_ID is the iOS app's bundle id and is the audience the
# identity token is verified against. Empty → POST /u/auth/apple answers
# 503 and the app hides the Apple button, exactly like Google's.
#
# Enable "Sign in with Apple" on that App ID in the Apple Developer portal
# first, then regenerate the provisioning profile. See docs/STORE_SUBMISSION.md.
APPLE_BUNDLE_ID=com.jashmenstudio.jashmen

# Only if the WEB ever offers Apple sign-in — the Service ID from the
# Developer portal. Native iOS does not need it.
APPLE_SERVICE_ID=

# ── Rate limits ─────────────────────────────────────────────────────────
# Hourly allowances, per IP. Raise them without a redeploy when many people
# share one address — a lecture hall on campus wi-fi is the case that
# actually turns students away.
# SIGNUP_RATE_LIMIT=10
# LEAD_RATE_LIMIT=12

# How many proxy hops sit in front of this process, for req.ip / rate
# limiting. Production is 2 (upstream NPM + local nginx). Set 0 when running
# the server directly with no proxy, or the limiter will trust a spoofable
# X-Forwarded-For header.
TRUST_PROXY_HOPS=2
